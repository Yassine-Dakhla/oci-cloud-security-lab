# ForgeSec Nginx example
# Replace YOUR_PUBLIC_HOST with the hostname or public IP currently serving ForgeSec.

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_PUBLIC_HOST;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name YOUR_PUBLIC_HOST;

    ssl_certificate /etc/letsencrypt/live/YOUR_PUBLIC_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_PUBLIC_HOST/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # FastAPI is bound to localhost only. Keep /api/ same-origin with the frontend.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        client_max_body_size 8k;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
